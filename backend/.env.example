# AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Bedrock — separate model per node (see app/graphs/prompts.py)
BEDROCK_INTAKE_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_GRADE_MODEL_ID=us.amazon.nova-micro-v1:0

# Bedrock — embeddings for the rules-dictionary RAG layer (app/rag/embeddings.py)
# Verify this matches the exact variable name read in embeddings.py before committing.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# DynamoDB — progress/XP/streak storage (app/services/stats_store.py)
DYNAMODB_TABLE_NAME=
DYNAMODB_REGION=ap-south-1
