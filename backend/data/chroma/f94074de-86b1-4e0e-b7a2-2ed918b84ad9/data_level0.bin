  },
  "operations":{
    "BatchDeleteAdvancedPromptOptimizationJob":{
      "name":"BatchDeleteAdvancedPromptOptimizationJob",
      "http":{
        "method":"POST",
        "requestUri":"/advanced-prompt-optimization-job/batch-delete",
