      "aws.auth#sigv4",
      "smithy.api#httpBearerAuth"
    ],
    "endpointPrefix":"bedrock",
    "protocol":"rest-json",
    "protocols":["rest-json"],
    "serviceFullName":"Amazon Bedrock",
    "serviceId":"Bedrock",
